{
  "mcpServers": {
    "nixos": {
      "type": "stdio",
      "command": "mcp-nixos"
    },
    "HA": {
      "type": "http",
      "url": "http://192.168.0.231:8123/api/mcp",
      "oauth": {
        "clientId": "http://localhost:12345",
        "callbackPort": 12345
      }
    },
    "solidcraft": {
      "type": "stdio",
      "command": "solidcraft-cli",
      "args": ["mcp"]
    },
    "solidcraft-live": {
      "type": "stdio",
      "command": "solidcraft-cli",
      "args": ["mcp", "--connect", "127.0.0.1:27878"]
    }
  }
}
