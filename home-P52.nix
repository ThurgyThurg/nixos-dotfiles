{
  config,
  pkgs,
  ...
}: let
  stm32cubemx = pkgs.callPackage ./packages/stm32cubemx/package.nix {};
in {
  imports = [./modules/common-home.nix];

  home.packages = [
    pkgs.kicad
    stm32cubemx
    (import ./packages/work-tuimer.nix {inherit pkgs;})
  ];

  programs.autorandr = {
    enable = true;
    profiles = {
      "undocked" = {
        fingerprint = {
          eDP-1 = "";
        };
        config = {
          eDP-1 = {
            enable = true;
            primary = true;
            mode = "2560x1440";
            rate = "60.00";
            position = "0x0";
          };
        };
      };
      "docked" = {
        fingerprint = {
          eDP-1 = "";
          DP-1-1 = "";
        };
        config = {
          eDP-1 = {
            enable = false;
            primary = false;
          };
          DP-1-1 = {
            enable = true;
            primary = true;
            mode = "5120x1440";
            rate = "120.00";
            position = "0x0";
          };
        };
      };
    };
  };

  programs.bash.shellAliases = {
    nrs = "sudo nixos-rebuild switch --flake ~/nixos-dotfiles#nixos-tim";
    ts2 = "tailscale --socket=/run/tailscale2/tailscaled.sock";
  };
}
